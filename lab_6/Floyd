import numpy as np

def floyd_algorithm(W):
    """Алгоритм Флойда - автоматичні обчислення"""
    n = len(W)
    D = np.copy(W)
    
    for k in range(n):
        for i in range(n):
            for j in range(n):
                if D[i][k] != float('inf') and D[k][j] != float('inf'):
                    if D[i][j] > D[i][k] + D[k][j]:
                        D[i][j] = D[i][k] + D[k][j]
    return D

# Початкова матриця ваг
W = [
    [0, float('inf'), 6, 7, float('inf'), 8, float('inf'), float('inf')],
    [float('inf'), 0, 1, 3, float('inf'), 2, 4, float('inf')],
    [6, 1, 0, float('inf'), float('inf'), float('inf'), float('inf'), 7],
    [7, 3, float('inf'), 0, 9, float('inf'), float('inf'), float('inf')],
    [float('inf'), float('inf'), float('inf'), 9, 0, float('inf'), 5, float('inf')],
    [8, 2, float('inf'), float('inf'), float('inf'), 0, float('inf'), 3],
    [float('inf'), 4, float('inf'), float('inf'), 5, float('inf'), 0, 4],
    [float('inf'), float('inf'), 7, float('inf'), float('inf'), 3, 4, 0]
]

# Виконуємо алгоритм
result = floyd_algorithm(W)

print("Результат програми:")
print("    1   2   3   4   5   6   7   8")
for i in range(8):
    print(f"{i+1:2} ", end="")
    for j in range(8):
        print(f"{int(result[i][j]):3}", end=" ")
    print()
