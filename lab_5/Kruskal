class Graph:
    def __init__(self, vertices):
        self.V = vertices
        self.graph = []
        self.T = []
        self.parent = [i for i in range(vertices)]
    
    def add_weighted_edge(self, u, v, w):
        self.graph.append([w, u, v])
    
    def find_set(self, i):
        if self.parent[i] == i:
            return i
        return self.find_set(self.parent[i])
    
    def union_set(self, u, v):
        self.parent[u] = self.parent[v]
    
    def kruskal(self):
        self.graph.sort()
        
        for i in range(len(self.graph)):
            w, u, v = self.graph[i]
            uRep = self.find_set(u)
            vRep = self.find_set(v)
            
            if uRep != vRep:
                self.T.append([u, v, w])
                self.union_set(uRep, vRep)
    
    def print_result(self):
        print("Edge : Weight")
        total_weight = 0
        for u, v, weight in self.T:
            print(f"{u+1} - {v+1} : {weight}")
            total_weight += weight
        print(f"Загальна вага: {total_weight}")

