V = 8
INF = 9999999

# Матриця суміжності графа
G = [
    [0, 0, 6, 7, 0, 8, 0, 0],
    [0, 0, 1, 3, 0, 2, 4, 0],
    [6, 1, 0, 0, 0, 0, 0, 7],
    [7, 3, 0, 0, 9, 0, 0, 0],
    [0, 0, 0, 9, 0, 0, 5, 0],
    [1, 2, 0, 0, 0, 0, 0, 3],
    [0, 4, 0, 0, 5, 0, 0, 4],
    [0, 0, 7, 0, 0, 3, 4, 0]
]

def prim_algorithm():
    selected = [False] * V
    no_edge = 0
    selected[0] = True  
    
    print("Edge : Weight")
    
    while no_edge < V - 1:
        minimum = INF
        x = 0
        y = 0
        
        for i in range(V):
            if selected[i]:
                for j in range(V):
                    if not selected[j] and G[i][j]:
                        if minimum > G[i][j]:
                            minimum = G[i][j]
                            x = i
                            y = j
        
        print(f"{x+1} - {y+1} : {G[x][y]}")
        selected[y] = True
        no_edge += 1

if __name__ == "__main__":
    prim_algorithm()
